# Salin file ini jadi ".env" (tanpa .example), lalu isi nilai aslinya.
# File ".env" TIDAK boleh commit ke git (sudah ada di .gitignore).

# Kredensial Postgres — SAMAKAN dengan yang dipakai container "postgres"
# yang sudah jalan (cek .env EduZone kamu / docker inspect postgres).
POSTGRES_USER=
POSTGRES_PASSWORD=

# Secret buat verifikasi JWT dari guru — HARUS SAMA PERSIS dengan
# JWT_SECRET yang dipakai Laravel (EduZone) menerbitkan token.
JWT_SECRET=

# Sinkronisasi otomatis schools_ref/people_ref/schedules_ref dari Laravel.
# OPSIONAL — biarkan SYNC_ENABLED=false (atau baris-baris ini dihapus)
# kalau endpoint Laravel-nya belum siap (lihat docs/laravel-sync-contract.md).
# LARAVEL_SYNC_TOKEN harus SAMA PERSIS dengan token yang dicek middleware
# Laravel — BUKAN JWT_SECRET di atas, sengaja secret yang beda.
SYNC_ENABLED=false
LARAVEL_SYNC_URL=http://eduzone_app:80
LARAVEL_SYNC_TOKEN=
SYNC_INTERVAL=5m
